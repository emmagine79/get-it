{
  "name": "get-it",
  "version": "0.1.0",
  "private": true,
  "description": "A calm day-planning desktop app for neurodivergent planners.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win --x64",
    "pack:win": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.emmagine.getit",
    "productName": "Get It",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "google.js",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  }
}
